{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			// "**/bin": true,
			"**/obj": true,
			// "**/test-results": true,
			"**/coverage-history": true
		},
		"workbench.settings.openDefaultSettings": true,
		"json.schemaDownload.trustedDomains": {
			"https://schemastore.org": true,
			"https://raw.githubusercontent.com/microsoft/testfx/main/docs/testconfig.schema.json": true
		},
		"json.schemaDownload.enable": true,
		"chat.tools.terminal.autoApprove": {
			"actionlint": true
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build",
				"command": "dotnet",
				"type": "shell",
				"args": [
					"build",
					"/property:GenerateFullPaths=true",
					"/consoleloggerparameters:NoSummary"
				],
				"group": "build",
				"presentation": {
					"reveal": "silent"
				},
				"problemMatcher": "$msCompile"
			}
		]
	}
}