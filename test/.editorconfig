# editorconfig.org
# We're being more relaxed about style in test projects.

root = false

[*.cs]

# Don't care about var anywhere
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = false:none
csharp_style_var_elsewhere = false:none

# Don't care about primary constructor
dotnet_diagnostic.IDE0290.severity = none

# TODO: Reevaluate whether these suppressions are appropriate
dotnet_diagnostic.xUnit1012.severity = none # Null should not be used for value type parameters
dotnet_diagnostic.xUnit2005.severity = none # Do not us identity check on value types

resharper_inconsistent_naming_highlighting = none
resharper_localizable_element_highlighting = none
resharper_convert_to_constant_local_highlighting = none