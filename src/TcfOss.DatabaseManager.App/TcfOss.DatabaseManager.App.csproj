<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcfOss.DatabaseManager.MySql\TcfOss.DatabaseManager.MySql.csproj" />
    <ProjectReference Include="..\TcfOss.DatabaseManager.MariaDb\TcfOss.DatabaseManager.MariaDb.csproj" />
    <ProjectReference Include="..\TcfOss.DatabaseManager.MsSql\TcfOss.DatabaseManager.MsSql.csproj" />
  </ItemGroup>

  <Target Name="GenerateBuildInfo" AfterTargets="MinVer" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
      <BuildContent>
namespace $(RootNamespace)
{
    public static class BuildInfo
    {
        public const string Date = "$(BuildDate) UTC"%3B
        public const string Version = "$(Version)"%3B
        public const string InformationalVersion = "$(InformationalVersion)"%3B
    }
}
      </BuildContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.cs" Lines="$(BuildContent)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
  </ItemGroup>

  <!-- Windows target if a win-* RID is specified, or none is specified and the host OS is Windows -->
  <PropertyGroup>
    <_IsWindowsTarget Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win'))">true</_IsWindowsTarget>
    <_IsWindowsTarget Condition="'$(RuntimeIdentifier)' == '' AND '$(OS)' == 'Windows_NT'">true</_IsWindowsTarget>
    <_IsWindowsTarget Condition="'$(_IsWindowsTarget)' == ''">false</_IsWindowsTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IsWindowsTarget)' == 'true'">
    <None Update="ninman.win.yml" Link="ninman.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsWindowsTarget)' != 'true'">
    <None Update="ninman.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
